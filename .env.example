# --- LLM (optional) ---
# If unset, the demo and evals run in REPLAY mode against recorded fixtures (fully offline / hermetic).
# If set, extraction uses the live Claude API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- ClickUp ---
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=

# --- Slack (for the n8n trigger; not needed for the offline demo) ---
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# --- State store (Postgres / Supabase) ---
# Used by the pipeline state store and the docker-compose stack.
POSTGRES_USER=agencyos
POSTGRES_PASSWORD=agencyos            # change before any non-local deployment
POSTGRES_DB=agencyos
DATABASE_URL=postgresql://agencyos:agencyos@localhost:5432/agencyos

# --- n8n stack (docker-compose) ---
# REQUIRED: encrypts all stored n8n credentials. Generate one and keep it stable:
#   openssl rand -hex 24
N8N_ENCRYPTION_KEY=
# Redis broker auth for queue mode.
REDIS_PASSWORD=agencyos               # change before any non-local deployment
N8N_HOST=localhost
GENERIC_TIMEZONE=Europe/Bucharest
